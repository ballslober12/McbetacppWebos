# McBetaCpp webOS settings. One KEY=VALUE per line, '#' starts a comment.
# Read at start-up from the folder that holds the McBetaCpp executable.
# A variable already set in the shell (SSH) wins over this file.

# Render scale is set in the game: Options > Video Settings > Render Scale
# (default 100%; Auto / 67% etc. draw at a lower resolution for more fps).
# If a run crashes while scaling, scaling switches itself off (scale_crashed.flag).
# Uncommenting this line FORCES a value and the in-game setting is then ignored:
#   auto       adapts between 100% / 80% / 67% / 50% to reach the target fps
#   0.5 .. 0.99 fixed scale
#   off        always native resolution
#MCBETA_RENDER_SCALE=auto
# Frame rate the auto mode aims for.
MCBETA_TARGET_FPS=60

# Gamepad speeds are set in the game: Options > Controls (Gamepad Look / Gamepad Cursor).
# These extra multipliers are applied on top of the in-game values (1.0 = no change).
#MCBETA_PAD_LOOK=1.0
#MCBETA_PAD_CURSOR=1.0
